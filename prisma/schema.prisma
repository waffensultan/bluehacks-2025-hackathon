generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String  @id @default(cuid())
  name        String
  email       String  @unique
  isVolunteer Boolean
  posts       Post[]

  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String // Name of the poster can be "Anonymous"
  tags      Tag[]

  // ADD: status -> has respondents or not

  @@map("posts")
}

model Tag {
  id     String @id @default(cuid())
  title  String
  postId String
  posts  Post?  @relation(fields: [postId], references: [id])

  @@map("tags")
}
