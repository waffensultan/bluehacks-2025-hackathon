generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  isVolunteer Boolean
  posts       Post[]
  createdAt   DateTime @default(now())

  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String? // Name of the poster can be "Anonymous"
  tags        Tag[]
  mediaUrl    String?
  baranggayId String
  baranggay   Baranggay  @relation(fields: [baranggayId], references: [id])
  status      PostStatus @default(AWAITING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // ADD: status -> has respondents or not

  @@map("posts")
}

model News {
  id          String    @id @default(cuid())
  title       String
  content     String
  baranggayId String
  baranggay   Baranggay @relation(fields: [baranggayId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("news")
}

enum PostStatus {
  AWAITING
  RESCUING
  RESCUED
}

model Tag {
  id     String @id @default(cuid())
  title  String
  postId String
  posts  Post?  @relation(fields: [postId], references: [id])

  @@map("tags")
}

model Baranggay {
  id    String @id @default(cuid())
  name  String
  posts Post[]
  news  News[]

  @@map("baranggays")
}
